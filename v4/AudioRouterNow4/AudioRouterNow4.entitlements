<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- MAS-Minimum: exakt diese 2 Keys (IMPLEMENTATION_PLAN.md Phase 0).
         app-sandbox ist Pflicht für App Store; audio-input ist der
         TCC-Entitlement-Pfad für AudioHardwareCreateProcessTap. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
